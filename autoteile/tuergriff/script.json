  "lines": [
    {
      "id": "l1",
      "start": 0.05,
      "end": 3,
      "text": "Türgriff greift ins Leere und die Tür geht nicht auf?"
    },
    {
      "id": "l2",
      "start": 3.2,
      "end": 7.6,
      "text": "Der Griff zieht über einen Seilzug oder eine Stange am Türschloss – das gibt die Tür frei."
    },
    {
      "id": "l3",
      "start": 7.8,
      "end": 11,
      "text": "Mit der Zeit bricht oft der Plastikhalter, oder der Seilzug hängt aus."
    },
    {
      "id": "l4",
      "start": 11.2,
      "end": 15.6,
      "text": "Dann ist der Griff locker, federt nicht zurück – oder die Tür geht nur noch von innen auf."
    },
    {
      "id": "l5",
      "start": 15.8,
      "end": 17,
      "text": "Ab in die Werkstatt!"
    },
    {
      "id": "l6",
      "start": 17.2,
      "end": 20.4,
      "text": "Und was soll als Nächstes drankommen? Schreib's in die Kommentare!"
    }
