  "lines": [
    {
      "id": "l1",
      "start": 0.05,
      "end": 3.2,
      "text": "Batterie neu – und trotzdem leer? Schuld ist oft die Lichtmaschine."
    },
    {
      "id": "l2",
      "start": 3.4,
      "end": 7.2,
      "text": "Der Keilriemen treibt sie an, sie macht Strom und lädt die Batterie."
    },
    {
      "id": "l3",
      "start": 7.4,
      "end": 9.6,
      "text": "Mit der Zeit verschleißen Kohlebürsten und Lager."
    },
    {
      "id": "l4",
      "start": 9.8,
      "end": 14,
      "text": "Dann leuchtet die Batterielampe, das Licht flackert, und irgendwann bleibt das Auto stehen."
    },
    {
      "id": "l5",
      "start": 14.2,
      "end": 18,
      "text": "Ab in die Werkstatt! Welches Auto fährst du? Schreib's unten rein."
    },
    {
      "id": "l6",
      "start": 18.2,
      "end": 21.4,
      "text": "Folg mir – nächstes Mal zeig ich, wie du's selbst prüfst."
    }
  ],
